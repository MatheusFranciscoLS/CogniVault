{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "feat/*": false,
      "fix/*": false,
      "ci/*": false,
      "chore/*": false,
      "security/*": false,
      "perf/*": false,
      "docs/*": false,
      "test/*": false,
      "ops/*": false,
      "refactor/*": false,
      "promote/*": false,
      "main": true
    }
  },
  "installCommand": "npm ci --prefix . --workspaces=false",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD ./ 2>/dev/null || exit 1",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/health/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cognivault-api.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://cognivault-api.onrender.com/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://cognivault-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
