# PostgreSQL usado pelo Prisma
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

# Gemini
GEMINI_API_KEY="SUA_CHAVE_GEMINI"
GEMINI_GENERATIVE_MODEL="gemini-3.7-flash"

# JWT
JWT_SECRET="TROQUE_POR_UM_SEGREDO_FORTE"

# Supabase Storage
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SECRET_KEY="SUA_CHAVE_SERVER_SIDE_DO_SUPABASE"
STORAGE_BUCKET="catalogos"

# RabbitMQ / CloudAMQP
RABBITMQ_URL="amqps://USUARIO:SENHA@HOST/VHOST"

# Backend local
PORT=3333

# CORS: em produção, coloque a URL exata do frontend Vercel.
# Pode separar múltiplas origens por vírgula.
CORS_ORIGINS="http://localhost:5173"

# Busca / confiança (opcionais)
# Use o mercado da implantação para não misturar variantes explicitamente marcadas
# no IPL (ex.: EU x Latin America). Se não houver variante compatível comprovada,
# o sistema preserva os candidatos e pede confirmação em vez de adivinhar.
PARTS_MARKET="Latin America"
PART_SEARCH_MAX_DISTANCE=0.65
PART_SEARCH_MIN_CONFIDENCE=0.72
FEEDBACK_MAX_DISTANCE=0.28
MIN_REPROCESS_PART_RATIO=0.5

# Puppeteer / Husqvarna B2B Portal
# Porta para conectar ao Opera GX / Google Chrome via CDP (Chrome DevTools Protocol)
# Rode seu navegador com: --remote-debugging-port=9222
CDP_DEBUG_PORT=9222