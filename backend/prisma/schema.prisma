generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                     @id @default(uuid())
  name                  String
  users                 User[]
  categories            Category[]
  documents             Document[]
  searchFeedback        SearchFeedback[]
  searchHistory         SearchHistory[]
  favorites             Favorite[]
  auditLogs             AuditLog[]
  officialVerifications OfficialPartVerification[]
  benchmarkRuns         AiBenchmarkRun[]
  createdAt             DateTime                   @default(now())
}

enum Role {
  ADMIN
  MECHANIC
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OfficialVerificationStatus {
  VERIFIED
  SUPERSEDED
  REVIEW
}

enum CatalogReviewStatus {
  PENDING
  READY
  NEEDS_REVIEW
  REVIEWED
}

model User {
  id                    String                     @id @default(uuid())
  email                 String                     @unique
  password              String
  role                   Role                       @default(MECHANIC)
  status                 UserStatus                 @default(PENDING)
  tenantId               String
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id])
  searchFeedback         SearchFeedback[]
  searchHistory          SearchHistory[]
  favorites              Favorite[]
  auditLogs              AuditLog[]
  officialVerifications  OfficialPartVerification[]
  reviewedDocuments      Document[]                 @relation("DocumentMetadataReviewer")
  benchmarkRuns          AiBenchmarkRun[]
  createdAt              DateTime                   @default(now())

  @@index([tenantId])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]
  createdAt DateTime   @default(now())

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Document {
  id          String  @id @default(uuid())
  filename    String
  url         String
  storagePath String?
  contentHash String?
  status      String  @default("PROCESSING")

  processingJobId    String?
  processingStage    String    @default("IDLE")
  processingCurrent  Int       @default(0)
  processingTotal    Int       @default(0)
  processingError    String?
  extractionSnapshot Json?
  extractionMethod   String?
  extractedAt        DateTime?

  manufacturer String?
  model        String?
  pnc          String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  chunks    DocumentChunk[]
  parts     Part[]
  favorites Favorite[]      @relation("FavoriteDocument")

  archivedAt      DateTime?
  archivedById    String?
  catalogRevision Int       @default(0)

  healthScore       Int                 @default(0)
  reviewStatus      CatalogReviewStatus @default(PENDING)
  reviewReasons     String[]            @default([])
  qualityCheckedAt  DateTime?
  metadataReviewedAt DateTime?
  metadataReviewedById String?
  metadataReviewedBy User?              @relation("DocumentMetadataReviewer", fields: [metadataReviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, model])
  @@index([tenantId, model, pnc])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([tenantId, contentHash])
  @@index([tenantId, reviewStatus])
  @@index([processingJobId])
  @@index([categoryId])
  @@index([metadataReviewedById])
}

model DocumentChunk {
  id                String                      @id @default(uuid())
  content           String
  searchText        String                      @default("")
  chunkType         String                      @default("TECHNICAL_CONTEXT")
  page              Int?
  section           String?
  model             String?
  normalizedModel   String?
  pnc               String?
  normalizedPnc     String?
  revision          Int                         @default(1)
  embeddingRevision Int                         @default(0)
  embedding         Unsupported("vector(768)")?
  documentId        String
  document          Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt         DateTime                    @default(now())

  @@index([documentId])
  @@index([documentId, revision])
  @@index([normalizedModel, normalizedPnc])
  @@index([page])
}

model Part {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  manufacturer           String?
  normalizedManufacturer String?

  model           String
  normalizedModel String

  pnc                String?
  normalizedPnc      String?
  universalAcrossPnc Boolean @default(false)

  section          String?
  position         String?
  name             String
  normalizedName   String
  alternativeNames String[] @default([])

  partNumber           String
  normalizedPartNumber String
  page                 Int?
  notes                String?
  searchText           String
  embedding            Unsupported("vector(768)")?
  sourceKey            String?
  active               Boolean                     @default(true)
  retiredAt            DateTime?
  extractionRevision   Int                         @default(1)
  embeddingRevision    Int                         @default(0)

  feedbackResults     SearchFeedback[] @relation("FeedbackResultPart")
  feedbackCorrections SearchFeedback[] @relation("FeedbackCorrectedPart")
  historyResults      SearchHistory[]  @relation("HistoryResultPart")
  favorites           Favorite[]       @relation("FavoritePart")

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([documentId, active])
  @@index([documentId, sourceKey])
  @@index([normalizedModel])
  @@index([normalizedModel, normalizedPnc])
  @@index([partNumber])
  @@index([normalizedPartNumber, active])
}

model SearchFeedback {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  query           String
  normalizedQuery String
  model           String?
  normalizedModel String?
  pnc             String?
  normalizedPnc   String?

  resultPartId String
  resultPart   Part   @relation("FeedbackResultPart", fields: [resultPartId], references: [id], onDelete: Cascade)

  correct         Boolean
  reason          String?
  correctedPartId String?
  correctedPart   Part?   @relation("FeedbackCorrectedPart", fields: [correctedPartId], references: [id], onDelete: SetNull)

  queryEmbedding Unsupported("vector(768)")?
  createdAt      DateTime                    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, normalizedModel, normalizedPnc])
  @@index([resultPartId])
  @@index([correctedPartId])
  @@index([userId])
}

model SearchHistory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query  String
  pnc    String?
  status String

  resultPartId   String?
  resultPart     Part?   @relation("HistoryResultPart", fields: [resultPartId], references: [id], onDelete: SetNull)
  resultLabel    String?
  resultCode     String?
  resultModel    String?
  resultPnc      String?
  sourceFilename String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([resultPartId])
}

model Favorite {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String
  label     String
  reference String?
  model     String?
  pnc       String?

  partId     String?
  part       Part?     @relation("FavoritePart", fields: [partId], references: [id], onDelete: SetNull)
  documentId String?
  document   Document? @relation("FavoriteDocument", fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, partId])
  @@unique([userId, documentId])
  @@index([tenantId, userId, createdAt])
  @@index([partId])
  @@index([documentId])
}

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model OfficialPartVerification {
  id                       String                     @id @default(uuid())
  tenantId                 String
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                   OfficialVerificationStatus
  queriedPartNumber        String
  normalizedQueriedNumber  String
  currentPartNumber        String
  normalizedCurrentNumber  String
  description              String?
  officialUrl              String
  note                     String?
  verifiedAt               DateTime
  createdAt                DateTime                   @default(now())

  @@index([tenantId, normalizedQueriedNumber, createdAt])
  @@index([tenantId, normalizedCurrentNumber, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model AiBenchmarkRun {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseCount Int
  metrics   Json
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}
