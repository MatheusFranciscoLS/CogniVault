// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. O coração do Multi-Tenant (A Empresa)
model Tenant {
  id         String     @id @default(uuid())
  name       String
  users      User[]
  categories Category[]
  documents  Document[]
  createdAt  DateTime   @default(now())
}

// 2. Sistema de Permissões e Aprovação
enum Role {
  ADMIN
  MECHANIC
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String     // Aqui guardaremos a senha criptografada (Hash)
  role      Role       @default(MECHANIC)
  status    UserStatus @default(PENDING) // Todo usuário nasce bloqueado até o ADM aprovar
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  createdAt DateTime   @default(now())
}

// 3. A Separação por Nichos (As Pastas de Máquinas)
model Category {
  id        String     @id @default(uuid())
  name      String     // Ex: "Roçadeiras", "Motosserras", "Tratores"
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]
  createdAt DateTime   @default(now())

  @@unique([name, tenantId]) // Impede que a mesma empresa crie duas pastas com o mesmo nome
}

// 4. O Catálogo Físico
model Document {
  id           String          @id @default(uuid())
  filename     String
  url          String
  status       String          @default("PROCESSING")

  manufacturer String?
  model        String?

  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id])

  chunks       DocumentChunk[]

  createdAt    DateTime        @default(now())

  @@index([tenantId, model])
}

// 5. A Memória Vetorial da IA (pgvector)
model DocumentChunk {
  id         String   @id @default(uuid())
  content    String
  embedding  Unsupported("vector(768)")?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}