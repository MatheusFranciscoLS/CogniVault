generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  users      User[]
  categories Category[]
  documents  Document[]
  searchFeedback SearchFeedback[]
  auditLogs  AuditLog[]
  createdAt  DateTime   @default(now())
}

enum Role {
  ADMIN
  MECHANIC
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role       @default(MECHANIC)
  status    UserStatus @default(PENDING)
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  searchFeedback SearchFeedback[]
  auditLogs  AuditLog[]
  createdAt DateTime   @default(now())
}

model Category {
  id        String     @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]
  createdAt DateTime   @default(now())

  @@unique([name, tenantId])
}

model Document {
  id           String          @id @default(uuid())
  filename     String
  url          String
  storagePath  String?
  status       String          @default("PROCESSING")

  manufacturer String?
  model        String?
  pnc          String?

  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id])

  chunks       DocumentChunk[]
  parts        Part[]

  archivedAt   DateTime?
  archivedById String?

  createdAt    DateTime        @default(now())

  @@index([tenantId, model])
  @@index([tenantId, model, pnc])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  content    String
  embedding  Unsupported("vector(768)")?
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Part {
  id                 String   @id @default(uuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  manufacturer       String?
  normalizedManufacturer String?

  model              String
  normalizedModel    String

  pnc                String?
  normalizedPnc      String?
  universalAcrossPnc Boolean  @default(false)

  section            String?
  position           String?
  name               String
  normalizedName     String
  alternativeNames   String[] @default([])

  partNumber         String
  page               Int?
  notes              String?
  searchText         String
  embedding          Unsupported("vector(768)")?

  feedbackResults    SearchFeedback[] @relation("FeedbackResultPart")
  feedbackCorrections SearchFeedback[] @relation("FeedbackCorrectedPart")

  createdAt          DateTime @default(now())

  @@index([documentId])
  @@index([normalizedModel])
  @@index([normalizedModel, normalizedPnc])
  @@index([partNumber])
}

model SearchFeedback {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  query              String
  normalizedQuery    String
  model              String?
  normalizedModel    String?
  pnc                String?
  normalizedPnc      String?

  resultPartId       String
  resultPart         Part     @relation("FeedbackResultPart", fields: [resultPartId], references: [id], onDelete: Cascade)

  correct            Boolean
  correctedPartId    String?
  correctedPart      Part?    @relation("FeedbackCorrectedPart", fields: [correctedPartId], references: [id], onDelete: SetNull)

  queryEmbedding     Unsupported("vector(768)")?
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, normalizedModel, normalizedPnc])
  @@index([resultPartId])
  @@index([correctedPartId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}
