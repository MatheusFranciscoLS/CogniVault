generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                     @id @default(uuid())
  name                  String
  users                 User[]
  categories            Category[]
  documents             Document[]
  searchFeedback        SearchFeedback[]
  searchHistory         SearchHistory[]
  favorites             Favorite[]
  auditLogs             AuditLog[]
  officialVerifications OfficialPartVerification[]
  benchmarkRuns         AiBenchmarkRun[]
  masterParts           MasterPart[]
  partLocations         PartLocation[]
  quoteUsages           QuoteUsage[]
  interactiveAiBudgetReservations InteractiveAiBudgetReservation[]
  quotes                Quote[]
  commercialImportRuns  CommercialImportRun[]
  createdAt             DateTime                   @default(now())
}

enum Role {
  ADMIN
  MECHANIC
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OfficialVerificationStatus {
  VERIFIED
  SUPERSEDED
  REVIEW
}

enum OfficialVerificationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CatalogReviewStatus {
  PENDING
  READY
  NEEDS_REVIEW
  REVIEWED
}

enum PartPositionStatus {
  POSITIONED
  SOURCE_UNPOSITIONED
  SUSPECT_MISSING
}

model User {
  id                            String                     @id @default(uuid())
  email                         String                     @unique
  password                      String
  sessionVersion                Int                        @default(0)
  role                          Role                       @default(MECHANIC)
  status                        UserStatus                 @default(PENDING)
  tenantId                      String
  tenant                        Tenant                     @relation(fields: [tenantId], references: [id])
  searchFeedback                SearchFeedback[]
  searchHistory                 SearchHistory[]
  favorites                     Favorite[]
  auditLogs                     AuditLog[]
  officialVerifications         OfficialPartVerification[] @relation("OfficialVerificationSubmitter")
  reviewedOfficialVerifications OfficialPartVerification[] @relation("OfficialVerificationReviewer")
  reviewedDocuments             Document[]                 @relation("DocumentMetadataReviewer")
  benchmarkRuns                 AiBenchmarkRun[]
  partLocationsUpdated          PartLocation[]             @relation("PartLocationUpdatedBy")
  quoteUsages                   QuoteUsage[]
  quotes                        Quote[]
  createdAt                     DateTime                    @default(now())

  @@index([tenantId])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]
  createdAt DateTime   @default(now())

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Document {
  id          String  @id @default(uuid())
  filename    String
  url         String
  storagePath String?
  contentHash String?
  status      String  @default("PROCESSING")

  processingJobId    String?
  processingStage    String    @default("IDLE")
  processingCurrent  Int       @default(0)
  processingTotal    Int       @default(0)
  processingError    String?
  extractionSnapshot Json?
  extractionMethod   String?
  /// Por que a leitura textual recusou este PDF e o processamento caiu para a
  /// IA (`DeterministicDeclineReason` em services/catalog-extractor.ts).
  /// Nulo quando a extração determinística funcionou. Existe para responder
  /// "vale estender o parser ou esse PDF é mesmo caso de leitura visual?" sem
  /// ter que baixar e reprocessar catálogo por catálogo.
  extractionFallbackReason String?
  /// Quantas linhas foram recusadas na gravação por terem código implausível
  /// (ver utils/part-number.ts). Serve para o descarte não ser silencioso: se
  /// esse número for alto, o catálogo foi lido errado e precisa de revisão.
  extractionRejectedParts  Int     @default(0)
  extractedAt        DateTime?

  manufacturer String?
  model        String?
  pnc          String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  chunks    DocumentChunk[]
  parts     Part[]
  favorites Favorite[]      @relation("FavoriteDocument")

  archivedAt      DateTime?
  archivedById    String?
  catalogRevision Int       @default(0)

  healthScore          Int                 @default(0)
  reviewStatus         CatalogReviewStatus @default(PENDING)
  reviewReasons        String[]            @default([])
  qualityCheckedAt     DateTime?
  metadataReviewedAt   DateTime?
  metadataReviewedById String?
  metadataReviewedBy   User?               @relation("DocumentMetadataReviewer", fields: [metadataReviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, model])
  @@index([tenantId, model, pnc])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([tenantId, archivedAt, status])
  @@index([tenantId, contentHash])
  @@index([tenantId, reviewStatus])
  @@index([processingJobId])
  @@index([categoryId])
  @@index([metadataReviewedById])
}

model DocumentChunk {
  id                String                      @id @default(uuid())
  content           String
  searchText        String                      @default("")
  chunkType         String                      @default("TECHNICAL_CONTEXT")
  page              Int?
  section           String?
  model             String?
  normalizedModel   String?
  pnc               String?
  normalizedPnc     String?
  revision          Int                         @default(1)
  embeddingRevision Int                         @default(0)
  embedding         Unsupported("vector(768)")?
  documentId        String
  document          Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt         DateTime                    @default(now())

  @@index([documentId])
  @@index([documentId, revision])
  @@index([normalizedModel, normalizedPnc])
  @@index([page])
}

model Part {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  manufacturer           String?
  normalizedManufacturer String?

  model           String
  normalizedModel String

  pnc                String?
  normalizedPnc      String?
  universalAcrossPnc Boolean @default(false)

  section          String?
  position         String?
  positionStatus   PartPositionStatus @default(POSITIONED)
  positionEvidence String?
  name             String
  normalizedName   String
  alternativeNames String[] @default([])

  partNumber           String
  normalizedPartNumber String
  page                 Int?
  notes                String?
  searchText           String
  embedding            Unsupported("vector(768)")?
  sourceKey            String?
  active               Boolean                     @default(true)
  retiredAt            DateTime?
  extractionRevision   Int                         @default(1)
  embeddingRevision    Int                         @default(0)

  feedbackResults     SearchFeedback[] @relation("FeedbackResultPart")
  feedbackCorrections SearchFeedback[] @relation("FeedbackCorrectedPart")
  historyResults      SearchHistory[]  @relation("HistoryResultPart")
  favorites           Favorite[]       @relation("FavoritePart")

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([documentId, active])
  @@index([documentId, sourceKey])
  @@index([normalizedModel])
  @@index([normalizedModel, active])
  @@index([normalizedModel, normalizedPnc])
  @@index([partNumber])
  @@index([normalizedPartNumber, active])
}

model MasterPart {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  partNumber       String
  normalizedNumber String
  name             String
  description      String?
  price            Float?
  ncm              String?
  ean              String?
  category         String?
  brand            String?
  // Campos vindos do ERP da loja (Clipp/CompuFour, Firebird). Todos anulaveis:
  // a lista de precos importada de planilha nao tem nenhum deles, e a loja nao
  // compra todas as pecas do catalogo — ausencia aqui e normal, nao defeito.
  stock            Int?
  /// Prateleira, como a loja escreve: "P13-A1", "PF", "P18-A5". Texto puro.
  location         String?
  /// Decide se o preco vale como esta ou pede conferencia. Ver utils/price-freshness.ts.
  lastPurchaseAt   DateTime?
  lastSaleAt       DateTime?
  sections         MasterPartSection[]
  updatedAt        DateTime            @default(now())

  @@unique([tenantId, normalizedNumber])
  @@index([tenantId, normalizedNumber])
}

model MasterPartSection {
  id               String     @id @default(uuid())
  tenantId         String
  normalizedNumber String
  section          String
  application      String?
  applicationKey   String     @default("")
  reference        String?
  productCategory  String?
  itemType         String?
  groupCode        String?
  sourceSheet      String
  updatedAt        DateTime   @default(now())
  masterPart       MasterPart @relation(fields: [tenantId, normalizedNumber], references: [tenantId, normalizedNumber], onDelete: Cascade)

  @@unique([tenantId, normalizedNumber, section, applicationKey])
  @@index([tenantId, section])
  @@index([tenantId, application])
  @@index([tenantId, applicationKey])
  @@index([tenantId, normalizedNumber])
}

model PartLocation {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  normalizedPartNumber String
  partNumber           String
  location             String
  note                 String?
  updatedById          String?
  updatedBy            User?    @relation("PartLocationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, normalizedPartNumber])
  @@index([tenantId, normalizedPartNumber])
  @@index([updatedById])
}

model QuoteUsage {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId            String
  normalizedPartNumber String
  partNumber           String
  model                String?
  createdAt             DateTime @default(now())

  @@unique([tenantId, sessionId, normalizedPartNumber])
  @@index([tenantId, normalizedPartNumber, createdAt])
  @@index([tenantId, model, createdAt])
  @@index([tenantId, sessionId])
  @@index([userId, createdAt])
}

enum QuoteStatus {
  // Cesta aberta do atendente. Exatamente uma por usuário, garantida por índice
  // parcial único criado na migration (Prisma não expressa índice parcial).
  DRAFT
  // Orçamento arquivado: o que o dono vê no painel e o balcão retoma depois.
  SAVED
}

/// Orçamento de balcão. Até 2026-09 isso vivia só no localStorage do navegador
/// de cada atendente — trocar de aparelho ou limpar o navegador apagava tudo e
/// o dono não tinha visão consolidada. Agora o navegador é só cache offline.
///
/// Dinheiro é `Float` aqui de propósito: `MasterPart.price` (a origem do preço)
/// também é Float, e o orçamento é explicitamente uma estimativa de balcão, não
/// um documento fiscal. Todo valor é arredondado a centavos no servidor
/// (`roundMoney` em services/quote.service.ts) antes de gravar, para não
/// acumular erro de ponto flutuante entre subtotal, desconto e total.
model Quote {
  id       String      @id @default(uuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Histórico de negócio sobrevive à remoção do atendente.
  userId   String?
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status   QuoteStatus @default(DRAFT)

  customerName       String?
  customerPhone      String?
  paymentMethod      String?
  machineModel       String?
  notes              String?
  discountPercentage Float   @default(0)

  totalItems     Int   @default(0)
  grossTotal     Float @default(0)
  discountAmount Float @default(0)
  netTotal       Float @default(0)

  items QuoteItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  savedAt   DateTime?

  @@index([tenantId, status, savedAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model QuoteItem {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // Ordem em que o atendente montou a cesta: o PDF e a ficha de separação
  // precisam sair na mesma ordem da tela.
  sortOrder Int   @default(0)

  partNumber           String
  normalizedPartNumber String
  manufacturer         String?
  effectiveCode        String?
  name                 String
  model                String?
  pnc                  String?
  section              String?
  position             String?
  filename             String?
  page                 Int?
  isSuperseded         Boolean @default(false)
  originalCode         String?
  notes                String?
  // Mão de obra, revisão, óleo avulso: entra no total mas nunca em métrica de
  // peça cotada nem em cobertura de catálogo.
  isService            Boolean @default(false)

  quantity  Int    @default(1)
  unitPrice Float?

  createdAt DateTime @default(now())

  @@index([quoteId, sortOrder])
  @@index([normalizedPartNumber])
}

model CommercialImportRun {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceFilename  String
  sourceHash      String
  priceDivisor    Float
  occurrenceCount Int       @default(0)
  masterCount     Int       @default(0)
  sectionCount    Int       @default(0)
  status          String    @default("RUNNING")
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([tenantId, startedAt])
  @@index([tenantId, sourceHash])
}

model SearchFeedback {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  query           String
  normalizedQuery String
  model           String?
  normalizedModel String?
  pnc             String?
  normalizedPnc   String?

  resultPartId String
  resultPart   Part   @relation("FeedbackResultPart", fields: [resultPartId], references: [id], onDelete: Cascade)

  correct         Boolean
  reason          String?
  correctedPartId String?
  correctedPart   Part?   @relation("FeedbackCorrectedPart", fields: [correctedPartId], references: [id], onDelete: SetNull)

  queryEmbedding Unsupported("vector(768)")?
  createdAt      DateTime                    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, normalizedModel, normalizedPnc])
  @@index([resultPartId])
  @@index([correctedPartId])
  @@index([userId])
}

model SearchHistory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query  String
  pnc    String?
  status String

  resultPartId   String?
  resultPart     Part?   @relation("HistoryResultPart", fields: [resultPartId], references: [id], onDelete: SetNull)
  resultLabel    String?
  resultCode     String?
  resultModel    String?
  resultPnc      String?
  sourceFilename String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([resultPartId])
}

model Favorite {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String
  label     String
  reference String?
  model     String?
  pnc       String?

  partId     String?
  part       Part?     @relation("FavoritePart", fields: [partId], references: [id], onDelete: SetNull)
  documentId String?
  document   Document? @relation("FavoriteDocument", fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, partId])
  @@unique([userId, documentId])
  @@index([tenantId, userId, createdAt])
  @@index([partId])
  @@index([documentId])
}

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model InteractiveAiBudgetReservation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  reservedTokens Int
  actualTokens  Int?
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId, day])
  @@index([tenantId, createdAt])
}

model OfficialPartVerification {
  id                        String                              @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User                                @relation("OfficialVerificationSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  status                    OfficialVerificationStatus
  approvalStatus            OfficialVerificationApprovalStatus @default(PENDING)
  queriedPartNumber         String
  normalizedQueriedNumber   String
  currentPartNumber         String
  normalizedCurrentNumber   String
  description               String?
  officialUrl               String
  note                      String?
  verifiedAt                DateTime
  reviewedById              String?
  reviewedBy                User?                               @relation("OfficialVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  reviewNote                String?
  createdAt                 DateTime                            @default(now())

  @@index([tenantId, normalizedQueriedNumber, createdAt])
  @@index([tenantId, normalizedCurrentNumber, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, approvalStatus, createdAt])
  @@index([userId, createdAt])
  @@index([reviewedById, createdAt])
}

model AiBenchmarkRun {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseCount Int
  metrics   Json
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

/// Pecas lidas do catalogo OFICIAL do fabricante (Briggs, Kawasaki), guardadas
/// para poderem ser PESQUISADAS.
///
/// O cache de fonte oficial responde "quais as pecas do motor X". Esta tabela
/// responde o contrario: "o cliente chegou com o codigo 592358, o que e isso e
/// de que motor e". Sem ela, cada atendimento lia 283 pecas e jogava fora.
///
/// Sem tenantId de proposito: e dado publico do fabricante, igual para todo
/// mundo, mesmo criterio do OfficialSourceCache.
///
/// Separada da tabela Part de proposito: Part pertence a um Document (PDF que a
/// loja subiu) e tem ciclo de vida proprio (active/reprocessamento). Aqui a
/// procedencia e outra e mais forte — veio da fonte oficial, nao de extracao.
model OfficialPartIndex {
  id               String   @id @default(uuid())
  /// 'BRIGGS' | 'KAWASAKI'
  source           String
  /// Motor de onde a peca foi lida: '104M02-0002-F1', 'FX921V-ES06'.
  engineModel      String
  normalizedEngine String
  /// Conjunto dentro do catalogo do motor ("Air Cleaner, Cylinder Head").
  assembly         String?
  /// Vazio em vez de nulo: entra na chave unica, e NULL nao casa com NULL no
  /// indice unico do Postgres — duas leituras criariam linhas duplicadas.
  position         String   @default("")
  partNumber       String
  normalizedNumber String
  name             String
  normalizedName   String
  quantity         Int?
  /// Quando o catalogo do fabricante foi lido pela ultima vez.
  readAt           DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([source, normalizedEngine, normalizedNumber, position])
  @@index([normalizedNumber])
  @@index([normalizedEngine])
}

model OfficialSourceCache {
  key                 String   @id
  source              String
  resourceType        String
  resourceId          String
  payload             Json
  fingerprint         String
  previousFingerprint String?
  fetchedAt           DateTime
  freshUntil          DateTime
  staleUntil          DateTime
  changedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([source, resourceType, resourceId])
  @@index([changedAt])
  @@index([freshUntil])
}
